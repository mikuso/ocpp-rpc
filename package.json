{
  "name": "ocpp-rpc",
  "description": "A client & server implementation of the WAMP-like RPC-over-websocket system defined in the OCPP protocols (e.g. OCPP1.6-J and OCPP2.0.1).",
  "main": "index.js",
  "scripts": {
    "test": "mocha",
    "coverage": "c8 --reporter=lcov --reporter=text mocha"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ocpp",
    "rpc",
    "websocket rpc",
    "wamp",
    "websockets",
    "ocpp-j",
    "ocpp1.6",
    "ocpp2.0.1",
    "ocpp1.6j",
    "ocpp2.0.1j",
    "ocpp2.1",
    "rpc server",
    "rpc client",
    "ocpp rpc",
    "ocpp websockets"
  ],
  "author": {
    "name": "Gareth Hughes",
    "url": "https://github.com/mikuso"
  },
  "bugs": {
    "url": "https://github.com/mikuso/ocpp-rpc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikuso/ocpp-rpc.git"
  },
  "homepage": "https://github.com/mikuso/ocpp-rpc#readme",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^2.1.1",
    "backoff": "^2.5.0",
    "ws": "^8.5.0"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "mocha": "^11.7.5"
  },
  "type": "module"
}
